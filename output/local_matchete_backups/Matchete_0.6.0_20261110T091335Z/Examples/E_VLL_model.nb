     SuperscriptBox["B", 
      StyleBox[
       TemplateBox[{"\[Mu]", "\[Nu]"},
        "RowDefault"],
       FontSize->10]], "2"], 
    FormBox[
     RowBox[{"Log", "[", 
      FractionBox[
       SuperscriptBox[
        OverscriptBox["\[Mu]", 
         StyleBox["_",
          FontWeight->Bold]], "2"], 
       SuperscriptBox["ME", "2"]], "]"}],
