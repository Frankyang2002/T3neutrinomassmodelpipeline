Cell["\<\
Check that that the matching results cover the complete EFT Lagrangian\
\>", "Text",
 CellChangeTimes->{{3.9604695459923964`*^9, 3.960469548605587*^9}, {
  3.9604697723843403`*^9, 
  3.960469810870323*^9}},ExpressionUUID->"d956deaa-b86f-4148-908c-\
15045eec3e5d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"EOMSimplify", "[", 
       RowBox[{
        RowBox[{"LSM", "+", 
         RowBox[{"(", 
          RowBox[{"LSMEFT", "/.", "LiteratureResults"}], ")"}], "-", 
         "LCrossCheck"}], ",", 
        RowBox[{"ReductionIdentities", "->", "FourDimensional"}]}], "]"}], "/.", 
      RowBox[{
       RowBox[{"Coupling", "[", 
        RowBox[{
         RowBox[{"Alternatives", "@@", 
          RowBox[{"SMEFTWilsonCoefficients", "[", "]"}]}], ",", "___"}], 
        "]"}], "->", "0"}]}], ")"}], "-", "LSM"}], "//", "GreensSimplify"}], "//",
   "NiceForm"}]], "Input",
 CellChangeTimes->{{3.960469569978147*^9, 3.960469571190954*^9}, {
  3.9604696083318233`*^9, 3.96046961113093*^9}, {3.960469744703959*^9, 
  3.960469753870722*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"1a1a137e-c59a-433b-8a4a-842541ec613e"],

Cell[BoxData["\<\"The Lagrangian contains terms of lower power than dimension \
4. Defining effective couplings and assuming these terms to be dimension 4. \
Use 'PrintEffectiveCouplings' and 'ReplaceEffectiveCouplings' to recover \
explicit expressions.\"\>"], "Echo",
 CellChangeTimes->{
  3.9633291990779743`*^9},ExpressionUUID->"673ce877-bffe-41c5-8573-\
1f141041f079"],

