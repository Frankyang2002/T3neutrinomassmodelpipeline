(* Batch 19: numeric audit of two Matchete-generated ordered C5 expressions.
   No use of a postulated neutrino-mass formula. No sequential matching.
   Run only on outputs just generated by this project's RunModel.wl. *)
ClearAll["Global`*"];
args = Rest[$ScriptCommandLine];
If[Length[args] =!= 3,
  Print["Usage: CompareT3BPlus1OneScaleC5.wl BASE_C5 EXTENDED_C5 OUTPUT.json"];
  Exit[2]
];
{baselinePath, generalPath, resultPath} = ExpandFileName /@ args;
If[!And @@ (FileExistsQ /@ {baselinePath, generalPath}),
  Print["Missing Matchete coefficient file"]; Exit[3]
];

(* ToExpression reads the source compiler's actual InputForm.  Inputs must be
   trusted local Matchete-generated artifacts, never arbitrary downloaded text. *)
loadCoeff[path_] := Module[{txt, result},
  txt = Quiet @ Check[Import[path, "Text"], $Failed];
  If[!StringQ[txt] || StringLength[txt] < 30, Return[$Failed]];
  result = Quiet @ Check[ToExpression[txt, InputForm], $Failed];
  If[result === $Failed || !FreeQ[result, $Failed | Indeterminate | ComplexInfinity],
    Return[$Failed]];
  result
];
base = loadCoeff[baselinePath];
general = loadCoeff[generalPath];
If[base === $Failed || general === $Failed, Print["Could not parse generated coefficient"]; Exit[4]];

(* The actual source labels of the first new model are fixed by its manifest. *)
allowed = {"y1", "y2", "MF", "MS1", "MS2", "lambdaT3", "lambdaT3ExtraQ022000I1"};
labels[expr_] := DeleteDuplicates @ Cases[
  expr, HoldPattern[Coupling[name_Symbol, ___]] :> SymbolName[Unevaluated[name]],
  {0, Infinity}
];
baseLabels = labels[base];
generalLabels = labels[general];
If[!SubsetQ[allowed, baseLabels] || !SubsetQ[allowed, generalLabels] ||
   !SubsetQ[baseLabels, {"y1", "y2", "MF", "lambdaT3"}] ||
   !SubsetQ[generalLabels, {"y1", "y2", "MF", "lambdaT3"}],
  Print["Unexpected or missing coupling labels: ", baseLabels, " / ", generalLabels];
  Exit[5]
];
If[MemberQ[baseLabels, "lambdaT3ExtraQ022000I1"],
  Print["Restricted source contains general quartic"]; Exit[6]
];

(* The epsilon pole is evaluated at a very large regulator value to isolate
   a finite-limit sample. This is NOT an MSbar-renormalised physical C5.
   We retain exact rational inputs and evaluate at 30-digit precision. *)
numericCoefficient[expr_, sample_Association, extra_] := Module[
  {m, s1, s2, yv1, yv2, lam, mu2, result, variables},
  m = sample["MF"]; s1 = sample["MS1"]; s2 = sample["MS2"];
  yv1 = sample["y1"]; yv2 = sample["y2"];
  lam = sample["lambdaT3"]; mu2 = m^2;
  result = expr /. {
    HoldPattern[Coupling[y1, ___]] :> yv1,
    HoldPattern[Coupling[y2, ___]] :> yv2,
    HoldPattern[Coupling[MF, ___]] :> m,
    HoldPattern[Coupling[MS1, ___]] :> s1,
    HoldPattern[Coupling[MS2, ___]] :> s2,
    HoldPattern[Coupling[lambdaT3, ___]] :> lam,
    HoldPattern[Coupling[lambdaT3ExtraQ022000I1, ___]] :> extra
  };
  result = result /. HoldPattern[Bar[x_]] :> Conjugate[x];
  (* Both Greek symbols are taken directly from the serialized InputForm. *)
  variables = {
    Symbol["Global`hbar"] -> 1/(16 Pi^2),
    Symbol["Global`ϵ"] -> 10^16,
    Symbol["Global`μbar2"] -> mu2
  };
  result = Quiet @ Check[N[result /. variables, 30], $Failed];
  If[result === $Failed || !NumericQ[result] ||
     !FreeQ[result, Indeterminate | ComplexInfinity | DirectedInfinity[_]],
    Return[$Failed]];
  result
];

samples = {
  <|"MF" -> 100000, "MS1" -> 1100, "MS2" -> 1300,
    "y1" -> 13/1000, "y2" -> 17/1000, "lambdaT3" -> 1/10|>,
  <|"MF" -> 110000, "MS1" -> 950, "MS2" -> 1400,
    "y1" -> 21/1000, "y2" -> 9/1000, "lambdaT3" -> 1/100|>,
  <|"MF" -> 85000, "MS1" -> 1500, "MS2" -> 2300,
    "y1" -> 7/1000, "y2" -> 25/1000, "lambdaT3" -> 1/5|>
};
(* RawJSON must receive ordinary finite machine-precision real values.
   Arbitrary-precision Wolfram *^ notation is not a JSON number literal.
   Retain high-precision arithmetic for deciding agreement; convert only
   the exported diagnostic values, never the underlying C5 comparisons. *)
toJSONReal[value_] := Module[{z},
  z = Quiet @ Check[N[value, MachinePrecision], $Failed];
  If[z === $Failed || !NumberQ[z] ||
     !TrueQ[Im[z] == 0] ||
     !FreeQ[z, Indeterminate | ComplexInfinity | DirectedInfinity[_]],
    Return[$Failed]];
  z = Re[z] + 0.;
  If[!TrueQ[Abs[z] < 10^300], Return[$Failed]];
  z
];
toJSONPair[value_] := Module[{r, im},
  r = toJSONReal[Re[value]];
  im = toJSONReal[Im[value]];
  If[r === $Failed || im === $Failed, Return[$Failed]];
  {r, im}
];

entries = Table[
  Module[{b, x0, x1, zeroErr, sensitivity, threshold, good,
          bOut, x0Out, x1Out, errorOut, sensitivityOut},
    b = numericCoefficient[base, samples[[i]], 0];
    x0 = numericCoefficient[general, samples[[i]], 0];
    x1 = numericCoefficient[general, samples[[i]], 1/10];
    good = And @@ (NumericQ /@ {b, x0, x1});
    If[!good, Return[$Failed]];
    threshold = Max[10^-40, Abs[b], Abs[x0], Abs[x1]];
    zeroErr = N[Abs[b - x0] / Max[10^-40, Abs[b], Abs[x0]], 16];
    sensitivity = N[Abs[x1 - x0] / threshold, 16];
    bOut = toJSONPair[b];
    x0Out = toJSONPair[x0];
    x1Out = toJSONPair[x1];
    errorOut = toJSONReal[zeroErr];
    sensitivityOut = toJSONReal[sensitivity];
    If[MemberQ[{bOut, x0Out, x1Out, errorOut, sensitivityOut}, $Failed],
      Return[$Failed]];
    <|"sample_index" -> i,
      "zero_extra_agrees" -> TrueQ[zeroErr < 10^-8],
      "all_numeric_values_finite" -> True,
      "restricted_c5_real_imag" -> bOut,
      "general_zero_extra_c5_real_imag" -> x0Out,
      "general_nonzero_extra_c5_real_imag" -> x1Out,
      "zero_extra_relative_error" -> errorOut,
      "extra_quartic_relative_effect" -> sensitivityOut,
      "nonzero_extra_changes_c5" -> TrueQ[sensitivity > 10^-8]|>
  ],
  {i, Length[samples]}
];
If[MemberQ[entries, $Failed] || !And @@ (Lookup[entries, "zero_extra_agrees", False]),
  Print["B(+1) numeric C5 comparison failed; one-scale source not validated"];
  Exit[7]
];
report = <|
  "format" -> "t3-b-plus1-c5-wolfram-numeric-audit-v1",
  "status" -> "Success", "model" -> "B_+1",
  "sample_count" -> Length[entries],
  "couplings_seen_baseline" -> baseLabels,
  "couplings_seen_general" -> generalLabels,
  "baseline_agrees_with_general_at_zero_extra" -> True,
  "nonzero_extra_changes_c5_at_any_sample" ->
    Or @@ Lookup[entries, "nonzero_extra_changes_c5", False],
  "samples" -> entries,
  "one_scale_only" -> True,
  "finite_regulator_sample_not_renormalised_msbar" -> True,
  "physical_matchete_rgbeta_coupling_map_certified" -> False
|>;
If[!DirectoryQ[DirectoryName[resultPath]],
  CreateDirectory[DirectoryName[resultPath], CreateIntermediateDirectories -> True]];
(* Confirm that the numerical report is a valid JSON object before saving.
   Normalise a possible Wolfram *^ exponent into the JSON-compatible e
   notation; fields have no free-form numeric-expression strings. *)
jsonText = Quiet @ Check[ExportString[report, "RawJSON"], $Failed];
If[!StringQ[jsonText] || StringLength[jsonText] < 50,
  Print["Cannot serialize native numeric audit"]; Exit[8]];
jsonText = StringReplace[jsonText,
  RegularExpression["(?<=[0-9])\\*\\^(?=[+-]?[0-9])"] -> "e"];
jsonRoundtrip = Quiet @ Check[ImportString[jsonText, "RawJSON"], $Failed];
If[!AssociationQ[jsonRoundtrip] ||
   Lookup[jsonRoundtrip, "sample_count", 0] =!= 3 ||
   Lookup[jsonRoundtrip, "status", ""] =!= "Success",
  Print["Native JSON serialisation roundtrip failed"]; Exit[8]];
If[Quiet @ Check[Export[resultPath, jsonText, "Text"], $Failed] === $Failed,
  Print["Could not write numeric audit JSON"]; Exit[8]];
Print["B(+1) one-scale C5 source numeric audit: 3/3 points verified -> ", resultPath];
