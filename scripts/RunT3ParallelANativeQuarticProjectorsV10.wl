(* Workstream A v10: genuine installed-RGBeta Lam and quartic Projector
   contractions in EFT1. No custom tGen components, no physical Wilson RGE.
   Source contract: RGBeta FieldsAndCouplings.m UpdateProjectors / Lam /
   CouplingTensorMap. Independent Matchete CG check is Python v9, not here.
   Usage: wolframscript -file scripts/RunT3ParallelANativeQuarticProjectorsV10.wl OUTPUT.json
   Outputs a diagnostic report, including failures; exits nonzero unless
   all 16 models and every intended native real-quartic response pass.
*)
ClearAll["Global`*"];
If[!MemberQ[{2,3},Length[$ScriptCommandLine]] ||
    (Length[$ScriptCommandLine]===3 && Last[$ScriptCommandLine]=!="SMOKE"),
  Print["Usage: RunT3ParallelANativeQuarticProjectorsV10.wl OUTPUT.json [SMOKE]"];Exit[64]];
T3A10Smoke = Length[$ScriptCommandLine]===3;
T3A10Output = ExpandFileName[$ScriptCommandLine[[2]]];
If[FileExistsQ[T3A10Output] || FileExistsQ[T3A10Output <> ".partial"],
  Print["v10 BLOCKED: refusing to overwrite existing native result/partial"];Exit[6]];
T3A10Root = DirectoryName @ DirectoryName @ ExpandFileName[$InputFileName];
T3A10Sources = {"RGE/running/rgbeta/T3RGBetaModel.wl",
  "scripts/RGBetaNativeAccess.wl",
  "scripts/RunT3ParallelANativeQuarticProjectorsV10.wl"};
If[!AllTrue[T3A10Sources, FileExistsQ[FileNameJoin[{T3A10Root,#}]] &],
  Print["v10 BLOCKED: source missing"];Exit[2]];
T3A10OptionalFlags = {"T3_EXPERIMENTAL_GENERAL_FERMIONS",
  "T3_EXPERIMENTAL_GENERAL_QUADRATICS",
  "T3_EXPERIMENTAL_GENERAL_QUARTICS",
  "T3_EXPERIMENTAL_FLAVOR_MASSES"};
T3A10EnabledFlags = Select[T3A10OptionalFlags, Environment[#] === "1" &];
If[Length[T3A10EnabledFlags] > 0,
  Print["v10 BLOCKED: optional T3 extensions enabled in Wolfram process: ",
        StringRiffle[T3A10EnabledFlags, ", "]];Exit[3]];
If[CheckAbort[Check[Needs["RGBeta`"];True,$Failed],$Aborted] =!= True,
  Print["v10 BLOCKED: installed RGBeta not available"];Exit[4]];
Get[FileNameJoin[{T3A10Root,"RGE","running","rgbeta","T3RGBetaModel.wl"}]];
Get[FileNameJoin[{T3A10Root,"scripts","RGBetaNativeAccess.wl"}]];

ClearAll[T3A10String,T3A10ModelLabel,T3A10CouplingName,T3A10Info,
 T3A10NativeResponse,T3A10Model,T3A10SymbolCensus,T3A10Record];
T3A10String[x_] := ToString[x,InputForm];
T3A10ModelLabel[cls_String,al_Integer] := cls <> "_" <>
  If[al<0,"-","+"] <> ToString[Abs[al]];
T3A10CouplingName[s_Symbol] := SymbolName[s];
T3A10Info[s_Symbol] := T3Stage22NativeInfo[s];
T3A10SymbolCensus[d1_,d2_,al_] := Module[{s},
  s={"lambdaH","lambdaS1","lambdaS2","lambdaH1","lambdaH2",
    "lambda12","lambdaT3"};
  If[d1>1,AppendTo[s,"lambdaH1Adj"]];
  If[d2>1,AppendTo[s,"lambdaH2Adj"]];
  If[d1===3,AppendTo[s,"lambdaS1Adj"]];
  If[d2===3,AppendTo[s,"lambdaS2Adj"]];
  If[d1>1 && d2>1,AppendTo[s,"lambda12Adj"]];
  If[d1===3 && d2===3,AppendTo[s,"lambda12Cross"]];
  If[d1===2 && d2===2 && al===-1,
    s=Join[s,{"lambdaHHdagS2S2","lambdaHHdagS1barS1bar",
    "lambdaS1bar2S2bar2","lambdaS1barS2S2bar2",
    "lambdaS1S1bar2S2bar","lambdaHHdagS1barS2barCross"}]];
  Sort[s]
];

(* Use actual RGBeta Quartic Projector against actual RGBeta Lam.
   Isolating the source coupling in Block prevents all unrelated tensors
   from polluting the contraction, without replacing any package function.
   The separate target coupling's Projector was generated by RGBeta on
   native model registration. RGBeta projectors need not be mutually
   orthogonal: the full response matrix is deliberately recorded.
*)
T3A10NativeResponse[target_Symbol,source_Symbol] := Module[
  {proj,contract,expanded,constant,coefficient,double,num},
  proj=Quiet@Check[T3Stage22NativeGet[T3A10Info[target],"Projector"],$Failed];
  If[proj===$Failed,Return[<|"ok"->False,"reason"->"projector_lookup_failed"|>]];
  contract=TimeConstrained[
    Quiet@Check[
      Block[{$quartics=KeyTake[$quartics,{source}]},
        Activate[proj[t10a,t10b,t10c,t10d]] *
          Lam[t10a,t10b,t10c,t10d]],
      $Failed],90,$Failed];
  If[contract===$Failed || contract===$Aborted,
    Return[<|"ok"->False,"reason"->"native_Lam_or_projector_failed_or_timed_out"|>]];
  expanded=TimeConstrained[Quiet@Check[
       FullSimplify[RefineGroupStructures[
         contract /. (Matrix|Tensor)[x_][__] :> x]],$Failed],90,$Failed];
  If[expanded===$Failed || expanded===$Aborted,
    Return[<|"ok"->False,"reason"->"native_refinement_failed_or_timed_out"|>]];
  constant=TimeConstrained[Quiet@Check[FullSimplify[expanded /. source->0],$Failed],30,$Failed];
  coefficient=TimeConstrained[Quiet@Check[FullSimplify[expanded /. source->1],$Failed],30,$Failed];
  double=TimeConstrained[Quiet@Check[FullSimplify[expanded /. source->2],$Failed],30,$Failed];
  If[constant===$Failed || coefficient===$Failed || double===$Failed ||
     !TrueQ[PossibleZeroQ[constant]] ||
     !TrueQ[PossibleZeroQ[FullSimplify[double-2 coefficient]]],
    Return[<|"ok"->False,"reason"->"nonlinear_or_nonzero_constant",
      "expanded_inputform"->StringTake[T3A10String[expanded],UpTo[320]]|>]];
  num=Quiet@Check[N[coefficient,17],$Failed];
  If[!NumericQ[num] || !TrueQ[Abs[Im[num]]<10^-8] ||
     !TrueQ[Abs[Re[num]]<10^8],
    Return[<|"ok"->False,"reason"->"unresolved_native_symbolic_coefficient",
      "coefficient_inputform"->StringTake[T3A10String[coefficient],UpTo[320]]|>]];
  <|"ok"->True,"value"->N[Re[num]],
    "coefficient_inputform"->StringTake[T3A10String[coefficient],UpTo[320]]|>
];

T3A10Record[s_Symbol] := Module[{info,fields,sc,perms,inv,coup},
  info=T3A10Info[s];
  fields=T3Stage22NativeGet[info,"Fields"];
  sc=T3Stage22NativeGet[info,"SelfConjugate"];
  perms=T3Stage22NativeGet[info,"UniqueArrangements"];
  inv=T3Stage22NativeGet[info,"Invariant"];
  coup=T3Stage22NativeGet[info,"Coupling"];
  <|"symbol"->SymbolName[s],"fields_inputform"->T3A10String[fields],
    "native_self_conjugate"->sc===True,
    "native_unique_arrangement_count"->Length[perms],
    "native_coupling_inputform"->T3A10String[coup],
    "native_invariant_inputform"->T3A10String[inv],
    "has_installed_RGBeta_projector"->
      MemberQ[T3Stage22NativeKeyName/@Keys[info],"Projector"]|>
];

T3A10Model[cls_String,alpha_Integer] := Module[
  {d1,d2,df,build,keys,names,expected,records,portals,which,ss,
   response,row,diagRows,diagOk,blockOk,invOk,allOk,phaseErr=False},
  {d1,d2,df}=Switch[cls,"A",{1,3,2},"B",{2,2,1},
    "C",{2,2,3},"D",{3,1,2},"E",{3,3,2}];
  Print["v10 native quartics: ",T3A10ModelLabel[cls,alpha]];
  build=Quiet@Check[T3RGBetaBuildEFT1[d1,d2,df,alpha],$Failed];
  If[!AssociationQ[build],Return[<|"ok"->False,"reason"->"EFT1_model_registration_failed",
       "dimensions"->{d1,d2,df},"alpha"->alpha|>]];
  keys=Keys[$quartics]; names=SymbolName/@keys;
  expected=T3A10SymbolCensus[d1,d2,alpha];
  invOk=Sort[names]===expected;
  If[!invOk,Print["v10 inventory mismatch ",T3A10ModelLabel[cls,alpha],
      " expected ",expected," received ",Sort[names]]];
  records=Quiet@Check[T3A10Record/@keys,$Failed];
  If[records===$Failed,Return[<|"ok"->False,"reason"->"native_registry_metadata_failed",
    "dimensions"->{d1,d2,df},"alpha"->alpha,"inventory_symbols"->Sort[names]|>]];
  diagRows=Table[
    If[TrueQ[Lookup[records[[j]],"native_self_conjugate",False]],
       response=T3A10NativeResponse[keys[[j]],keys[[j]]];
       <|"symbol"->names[[j]],"native_response"->response|>,Nothing],
    {j,Length[keys]}];
  diagOk=AllTrue[diagRows,
    TrueQ[#["native_response"]["ok"]] &&
      Abs[#["native_response"]["value"]-1]<10^-8 &];
  portals=Table[
    ss=Select[keys, MemberQ[{
       "lambdaH"<>ToString[which],"lambdaH"<>ToString[which]<>"Adj"},
       SymbolName[#]]&];
    ss=SortBy[ss,If[StringEndsQ[SymbolName[#],"Adj"],1,0]&];
    row=Table[T3A10NativeResponse[ss[[i]],ss[[j]]],
      {i,Length[ss]},{j,Length[ss]}];
    <|"which"->which,"dimension"->If[which===1,d1,d2],
      "symbols"->(SymbolName/@ss),"native_response_matrix"->row|>,
    {which,1,2}];
  blockOk=AllTrue[portals,Function[sector,
    AllTrue[Flatten[sector["native_response_matrix"]],
       TrueQ[Lookup[#,"ok",False]]&]]];
  allOk=invOk && diagOk && blockOk &&
     Count[records,r_/;r["native_self_conjugate"]===True]===Length[diagRows];
  <|"ok"->allOk,"dimensions"->{d1,d2,df},"alpha"->alpha,
    "registered_quartics_count"->Length[names],
    "registry_exact_source_inventory"->invOk,"inventory"->records,
    "native_real_self_projectors"->diagRows,
    "native_portal_response_blocks"->portals,
    "native_real_self_projectors_all_unit"->diagOk,
    "native_portal_response_blocks_evaluated"->blockOk,
    "complex_quartics_are_inventory_only"->True,
    "native_numeric_S2_components_measured"->False|>
];

T3A10Cases=If[T3A10Smoke, {{"A",-4},{"B",-1},{"E",-2}},
 Join[({"A",#}&/@{-4,-2,0}),({"B",#}&/@{-3,-1,1}),
  ({"C",#}&/@{-3,-1,1}),({"D",#}&/@{-2,0,2}),
  ({"E",#}&/@{-4,-2,0,2})]];
T3A10Models=Association@Table[
  With[{cls=First[c],al=Last[c]},
    T3A10ModelLabel[cls,al]->Module[{captured},
      captured=CheckAbort[
        Quiet@Check[Catch[T3A10Model[cls,al],"T3Stage22Native"],
          <|"ok"->False,"reason"->"native_model_exception"|>],
          <|"ok"->False,"reason"->"native_model_aborted"|>];
      If[AssociationQ[captured],captured,
         <|"ok"->False,"reason"->"native_model_threw_or_returned_nonassociation"|>]
      ]],
   {c,T3A10Cases}];
T3A10OK=Length[T3A10Models]===If[T3A10Smoke,3,16] &&
  AllTrue[Values[T3A10Models],TrueQ[Lookup[#,"ok",False]]&];
T3A10SHA=Association@Table[
  s->IntegerString[FileHash[FileNameJoin[{T3A10Root,s}],"SHA256"],16,64],
  {s,T3A10Sources}];
T3A10Package=Quiet@Check[FindFile["RGBeta`"],$Failed];
T3A10Report=<|
 "format"->"t3-parallel-a-native-rgbeta-quartic-projectors-v10",
 "status"->If[T3A10OK,
      If[T3A10Smoke,"NativeRGBetaQuarticProjectorSmoke3ModelsPassed",
       "NativeRGBetaRealQuarticLamProjectorResponsesObserved_Conditional"],
      "Blocked_NativeRGBetaQuarticProjectorResponses"],
 "smoke_only"->T3A10Smoke,
 "native_Lam_evaluated"->True,"native_quartic_projectors_evaluated"->True,
 "registered_model_count"->Length[T3A10Models],
 "source_sha256"->T3A10SHA,
 "installed_RGBeta_main_file"->If[StringQ[T3A10Package],T3A10Package,"unavailable"],
 "installed_RGBeta_main_file_sha256"->If[StringQ[T3A10Package]&&FileExistsQ[T3A10Package],
    IntegerString[FileHash[T3A10Package,"SHA256"],16,64],"unavailable"],
 "native_coupling_response_is_symbolic_not_component_Lam"->True,
 "native_numeric_S2_frame_measured"->False,
 "native_Matchete_scalar_CG_evaluated"->False,
 "full_scalar_potential_dictionary_certified"->False,
 "physical_Wilson_evolution_authorized"->False,
 "EFT_order"->"UV -> integrate out ALL fermions -> integrate out ALL scalars -> SMEFT",
 "models"->T3A10Models|>;
If[!DirectoryQ[DirectoryName[T3A10Output]],
  CreateDirectory[DirectoryName[T3A10Output],CreateIntermediateDirectories->True]];
T3A10Partial=T3A10Output<>".partial";
T3A10Written=CheckAbort[Quiet@Check[
  Export[T3A10Partial,T3A10Report,"RawJSON"],$Failed],$Aborted];
If[T3A10Written===$Failed || T3A10Written===$Aborted ||
  !FileExistsQ[T3A10Partial],Print["v10 BLOCKED: native JSON write failed"];Exit[9]];
T3A10ReadBack=Quiet@Check[Import[T3A10Partial,"RawJSON"],$Failed];
If[!AssociationQ[T3A10ReadBack] ||
    Lookup[T3A10ReadBack,"format",None]=!=Lookup[T3A10Report,"format"],
   Print["v10 BLOCKED: native JSON roundtrip failed"];Exit[9]];
If[Quiet@Check[RenameFile[T3A10Partial,T3A10Output],$Failed]===$Failed,
 Print["v10 BLOCKED: atomic rename failed"];Exit[9]];
T3A10Total=Total[Lookup[Values[T3A10Models],"registered_quartics_count",0]];
T3A10Diag=Total[Length[Lookup[#,"native_real_self_projectors",{}]]&/@Values[T3A10Models]];
Print["v10: ",Length[T3A10Models],"/",If[T3A10Smoke,3,16]," native EFT1 models; ",
 T3A10Total," quartic slots; ",T3A10Diag," real Lam-projector diagonal contractions"];
Print[Lookup[T3A10Report,"status"]<>" -> "<>T3A10Output];
Print["Native symbolic Lam and projector only; component-level normalization and physics BLOCKED."];
If[!T3A10OK,Exit[7]];
Exit[0];
